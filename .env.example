# ============================================================
# Vercel -> Settings -> Environment Variables
# NEXT_PUBLIC_ prefiksi YO'Q o'zgaruvchilar faqat serverda ishlaydi
# ============================================================

# Telegram bot (lidlar shu gruppaga tushadi)
TG_TOKEN=
TG_CHAT_ID=

# Videodars beradigan bot (forma to'ldirgandan keyin shu yerga o'tadi)
NEXT_PUBLIC_BOT_URL=https://t.me/BOT_USERNAME?start=dars

# Bitrix24 kiruvchi webhook (ixtiyoriy)
B24_WEBHOOK=

# Meta Pixel / Yandex Metrika (ixtiyoriy)
NEXT_PUBLIC_FB_PIXEL=
NEXT_PUBLIC_YM_ID=
